# Copy to .env and adjust before running: cp .env.example .env

# SQL Server SA password (must meet complexity requirements)
DB_PASSWORD=StayHub@Dev12345!

# Load 6000+ line sample seed on first init (true/false)
LOAD_SAMPLE_DATA=true

# Public URLs — used for payment callbacks and email links
PUBLIC_API_URL=http://localhost:7010
PUBLIC_FRONTEND_URL=http://localhost:5173

# Production domains (only used with: docker compose --profile prod)
DOMAIN=stayhub.example.com
API_DOMAIN=api.stayhub.example.com

# Shared JWT secret — change in production
JWT_KEY=UJUBu7tYVyug8wei9YIGguygvisbd87Y7tgggyftfufyufbhsvv878687585geyg86698uiggUIGIGYg77523T867

# Internal service key
INTERNAL_SERVICE_KEY=StayHub_Internal_Service_Key_2026

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth (backend validates token)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email (password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SENDER=StayHub Support
EMAIL_ADDRESS=your@gmail.com
EMAIL_USERNAME=your@gmail.com
EMAIL_PASSWORD=your-app-password

# VNPay sandbox
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo sandbox
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key
MOMO_API_URL=https://test-payment.momo.vn/gw_payment/transactionProcessor

# Frontend build-time variables (Vite)
VITE_API_BASE_URL=http://localhost:7010
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key
VITE_FACEBOOK_APP_ID=your-facebook-app-id
VITE_CHATBOX=your-gemini-api-key
VITE_CAPCHA_KEY=your-recaptcha-site-key

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "roles-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/roles/{**catch-all}" }
      },

      "tours-route": {
        "ClusterId": "tour-cluster",
        "Match": { "Path": "/api/tours/{**catch-all}" }
      },
      "tours-itineraries-route": {
        "ClusterId": "tour-cluster",
        "Match": { "Path": "/api/touritineraries/{**catch-all}" }
      },
      "tours-schedule-itineraries-route": {
        "ClusterId": "tour-cluster",
        "Match": { "Path": "/api/tourscheduleitineraries/{**catch-all}" }
      },
      "tours-schedule-route": {
        "ClusterId": "tour-cluster",
        "Match": { "Path": "/api/tourschedules/{**catch-all}" }
      },
      "tours-schedule-staff-route": {
        "ClusterId": "tour-cluster",
        "Match": { "Path": "/api/tourschedulestaffs/{**catch-all}" }
      },
      "tours-schedule-ticket-route": {
        "ClusterId": "tour-cluster",
        "Match": { "Path": "/api/tourscheduletickets/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "booking-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "tickets-route": {
        "ClusterId": "booking-cluster",
        "Match": { "Path": "/api/tickets/{**catch-all}" }
      },
      "reviews-route": {
        "ClusterId": "tour-cluster",
        "Match": { "Path": "/api/reviews/{**catch-all}" }
      },

      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/vnpay/{**catch-all}" }
      },

      "vouchers-route": {
        "ClusterId": "voucher-cluster",
        "Match": { "Path": "/api/vouchers/{**catch-all}" }
      },
      "customer-vouchers-route": {
        "ClusterId": "voucher-cluster",
        "Match": { "Path": "/api/customer/vouchers/{**catch-all}" }
      },
      "internal-vouchers-route": {
        "ClusterId": "voucher-cluster",
        "Match": { "Path": "/api/internal/vouchers/{**catch-all}" }
      },
      "wallets-route": {
        "ClusterId": "voucher-cluster",
        "Match": { "Path": "/api/wallets/{**catch-all}" }
      },

      "social-map-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/api/tour-groups/{**catch-all}" }
      },
      "social-locations-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/api/locations/{**catch-all}" }
      },
      "social-friends-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/api/friends/{**catch-all}" }
      },
      "social-moments-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/api/moments/{**catch-all}" }
      },
      "social-funds-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/api/expense-groups/{**catch-all}" }
      },
      "social-signalr-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/hubs/{**catch-all}" }
      },

      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": { "Path": "/api/ai/{**catch-all}" }
      },
      "ar-route": {
        "ClusterId": "ai-cluster",
        "Match": { "Path": "/api/ar/{**catch-all}" }
      },

      "notifications-route": {
        "ClusterId": "system-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },

      "system-notifications-hub-route": {
        "ClusterId": "system-cluster",
        "Match": { "Path": "/hubs/notifications/{**catch-all}" }
      },

      "admin-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/admin/{**catch-all}" }
      },
      "weathers-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/weatherforecast/{**catch-all}" }
      },
      "banners-route": {
        "ClusterId": "content-cluster",
        "Match": { "Path": "/api/banners/{**catch-all}" }
      },
      "categories-route": {
        "ClusterId": "content-cluster",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "ticket-type-route": {
        "ClusterId": "content-cluster",
        "Match": { "Path": "/api/tickettypes/{**catch-all}" }
      },
      "wishlists-route": {
        "ClusterId": "tour-cluster",
        "Match": { "Path": "/api/wishlists/{**catch-all}" }
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "dest": { "Address": "https://localhost:7001/" }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "dest": { "Address": "https://localhost:7002/" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "dest": { "Address": "https://localhost:7003/" }
        }
      },
      "social-cluster": {
        "Destinations": {
          "dest": { "Address": "https://localhost:7004/" }
        }
      },
      "tour-cluster": {
        "Destinations": {
          "dest": { "Address": "https://localhost:7005/" }
        }
      },
      "voucher-cluster": {
        "Destinations": {
          "dest": { "Address": "https://localhost:7006/" }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "dest": { "Address": "https://localhost:7007/" }
        }
      },
      "content-cluster": {
        "Destinations": {
          "dest": { "Address": "https://localhost:7008/" }
        }
      },
      "system-cluster": {
        "Destinations": {
          "dest": { "Address": "https://localhost:7009/" }
        }
      }
    }
  }
}
